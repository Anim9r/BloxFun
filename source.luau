AppendButtonSerial = 0;
UsedButtonSerials = {};
local function CreateTabButton(TabName, ButtonSerial, ButtonText, ButtonIcon, IconCorner, CallbackFunction)
    _Frame = Instance.new("Frame")
    _Roundify = Instance.new("ImageLabel")
    _Roundify_Gradient = Instance.new("UIGradient")
    _Roundify_Frame = Instance.new("Frame")
    _Roundify_Frame_GridLayout = Instance.new("UIGridLayout")
    _Script = Instance.new("ImageButton")
	_Script_Corner = Instance.new("UICorner")
    _Roundify_InvisFrame = Instance.new("Frame")
    _Roundify_InvisFrame_GridLayout = Instance.new("UIGridLayout")
    _AssetName = Instance.new("TextLabel")
    _TextLabel_Gradient = Instance.new("UIGradient")
    _Frame_GridLayout = Instance.new("UIGridLayout")
	
	table.insert(BloxFunGui, {_Frame, _Roundify, _Roundify_Gradient, _Roundify_Frame, _Roundify_Frame_GridLayout, _Script, _Script_Corner, _Roundify_InvisFrame, _Roundify_InvisFrame_GridLayout, _AssetName, _TextLabel_Gradient, _Frame_GridLayout})
    
    if anycase(ButtonSerial) == anycase("RANDOM") or anycase(ButtonSerial) == '' then
        local RandomNumber;
        repeat RandomNumber = math.random(100000, 999999) until not table.find(UsedButtonSerials, RandomNumber)
        table.insert(UsedButtonSerials, RandomNumber)
        ButtonSerial = tostring(RandomNumber)
    elseif anycase(ButtonSerial) == anycase("APPEND") then
        AppendButtonSerial = AppendButtonSerial + 1
        ButtonSerial = tostring(AppendButtonSerial)
    end

	if IconCorner == '' then IconCorner = 0 end

	local ButtonIconType;
	if string.find(anycase(ButtonIcon), anycase("RAW:")) then ButtonIconType = string.gsub(anycase(ButtonIcon), anycase("RAW:"), "")
	-- elseif string.find(ButtonIcon, "GCA:") then ButtonIconType = getcustomassetid(string.gsub(ButtonIcon, "GCA:", ""))
	else ButtonIconType = THUMBNAILAID..ButtonIcon end

	_Frame.Name = "Tab"..tostring(TabName).."Button"..tostring(ButtonSerial).."_Frame"
	_Frame.Parent = BloxFunGui["Tab"..TabName.."ScrollingFrame"]
	_Frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	_Frame.BackgroundTransparency = 1.000
	_Frame.BorderSizePixel = 0
	_Frame.Size = UDim2.new(0, 100, 0, 100)

	_Roundify.Name = "Tab"..TabName.."Button"..ButtonSerial.."_Roundify"
	_Roundify.Parent = _Frame
	_Roundify.AnchorPoint = Vector2.new(0.5, 0.5)
	_Roundify.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	_Roundify.BackgroundTransparency = 1.000
	_Roundify.Position = UDim2.new(4.44999981, 0, 1.62000012, 0)
	_Roundify.Size = UDim2.new(1, 24, 1, 24)
	_Roundify.Image = "rbxassetid://3570695787"
	_Roundify.ScaleType = Enum.ScaleType.Slice
	_Roundify.SliceCenter = Rect.new(100, 100, 100, 100)
	_Roundify.SliceScale = 0.120

	_Roundify_Gradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 122, 5)), ColorSequenceKeypoint.new(1.00, Color3.fromRGB(124, 56, 0))}
	_Roundify_Gradient.Rotation = 87.5
	_Roundify_Gradient.Name = "Tab"..TabName.."Button"..ButtonSerial.."_Roundify_Gradient"
	_Roundify_Gradient.Parent = _Roundify

	_Roundify_Frame.Name = "Tab"..TabName.."Button"..ButtonSerial.."_Roundify_Frame"
	_Roundify_Frame.Parent = _Roundify
	_Roundify_Frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	_Roundify_Frame.BackgroundTransparency = 1.000
	_Roundify_Frame.BorderSizePixel = 0
	_Roundify_Frame.Size = UDim2.new(0, 100, 0, 85)
	
    _Roundify_Frame_GridLayout.Name = "Tab"..TabName.."Button"..ButtonSerial.."_Roundify_Frame_GridLayout"
	_Roundify_Frame_GridLayout.Parent = _Roundify_Frame
	_Roundify_Frame_GridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	_Roundify_Frame_GridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	_Roundify_Frame_GridLayout.CellPadding = UDim2.new(0, 10, 0, 10)
	_Roundify_Frame_GridLayout.CellSize = UDim2.new(0, 88, 0, 83)

	_Script.Name = "Tab"..TabName.."Button"..ButtonSerial.."_Script"
	_Script.Parent = _Roundify_Frame
	_Script.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	_Script.BackgroundTransparency = 1.000
	_Script.BorderSizePixel = 0
	_Script.Size = UDim2.new(0, 100, 0, 100)
	_Script.Image = ButtonIconType

	_Script_Corner.Name =  "Tab"..TabName.."Button"..ButtonSerial.."_Script_Corner"
	_Script_Corner.Parent = _Script
	_Script_Corner.CornerRadius = UDim.new(0, tonumber(IconCorner))

	_Roundify_InvisFrame.Name = "Tab"..TabName.."Button"..ButtonSerial.."_Roundify_InvisFrame"
	_Roundify_InvisFrame.Parent = _Roundify
	_Roundify_InvisFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	_Roundify_InvisFrame.BackgroundTransparency = 1.000
	_Roundify_InvisFrame.BorderSizePixel = 0
	_Roundify_InvisFrame.Position = UDim2.new(0, 0, 0.708333313, 0)
	_Roundify_InvisFrame.Size = UDim2.new(0, 100, 0, 35)
	
    _Roundify_InvisFrame_GridLayout.Name = "Tab"..TabName.."Button"..ButtonSerial.."_Roundify_InvisFrame_GridLayout"
	_Roundify_InvisFrame_GridLayout.Parent = _Roundify_InvisFrame
	_Roundify_InvisFrame_GridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	_Roundify_InvisFrame_GridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	_Roundify_InvisFrame_GridLayout.CellSize = UDim2.new(0, 96, 0, 35)

	_AssetName.Name = "Tab"..TabName.."Button"..ButtonSerial.."_AssetName"
	_AssetName.Parent = _Roundify_InvisFrame
	_AssetName.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	_AssetName.BackgroundTransparency = 1.000
	_AssetName.BorderSizePixel = 0
	_AssetName.Size = UDim2.new(0, 200, 0, 50)
	_AssetName.Font = Enum.Font.Cartoon
	_AssetName.Text = ButtonText
	_AssetName.TextColor3 = Color3.fromRGB(255, 255, 255)
	_AssetName.TextScaled = true
	_AssetName.TextSize = 11.000
	_AssetName.TextWrapped = true

	_TextLabel_Gradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(0.44, Color3.fromRGB(235, 235, 235)), ColorSequenceKeypoint.new(1.00, Color3.fromRGB(239, 239, 239))}
	_TextLabel_Gradient.Rotation = 80
	_TextLabel_Gradient.Name = "Tab"..TabName.."Button"..ButtonSerial.."_TextLabel_Gradient"
	_TextLabel_Gradient.Parent = _AssetName

	_Frame_GridLayout.Name = "Tab"..TabName.."Button"..ButtonSerial.."_Frame_GridLayout"
	_Frame_GridLayout.Parent = _Frame
	_Frame_GridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	_Frame_GridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	_Frame_GridLayout.CellPadding = UDim2.new(0, 10, 0, 10)
	_Frame_GridLayout.CellSize = UDim2.new(0, 100, 0, 120)
	
	_Script.MouseButton1Down:Connect(CallbackFunction)
end
