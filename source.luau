---Searcher Engine:
local function SearchContent(TabName)
    if CoreGui["BloxFunGui"].BaseFrame.SearchBar.SearchBar_TextBox.Text ~= "" then
        for _, v in pairs(CoreGui["BloxFunGui"].BaseFrame["Tab"..TabName.."ScrollingFrame"]:GetChildren()) do
            if v:IsA("Frame") then
                for _, t in pairs(v:GetDescendants()) do
                    if t:IsA("TextLabel") then
                        if string.find(string.lower(t.Text), string.lower(CoreGui["BloxFunGui"].BaseFrame.SearchBar.SearchBar_TextBox.Text)) then
                            v.Visible = true
                            CoreGui["BloxFunGui"].BaseFrame["Tab"..TabName.."ScrollingFrame"].CanvasPosition = Vector2.new(0, 0)
                        else
                            v.Visible = false
                            CoreGui["BloxFunGui"].BaseFrame["Tab"..TabName.."ScrollingFrame"].CanvasPosition = Vector2.new(0, 0)
                        end
                    end
                end
            end
        end
    else
        for _,v in pairs(CoreGui["BloxFunGui"].BaseFrame["Tab"..TabName.."ScrollingFrame"]:GetChildren()) do
            if v:IsA("Frame") then
                v.Visible = true
                CoreGui["BloxFunGui"].BaseFrame["Tab"..TabName.."ScrollingFrame"].CanvasPosition = Vector2.new(0, 0)
            end
        end
    end
end

